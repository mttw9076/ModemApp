@using WebApp.Application.Devices.Commands.CreateSimCard
@model CreateSimCardCommand

@{
    ViewData["Title"] = "Dodaj urządzenie";
}

<h2>Dodaj urządzenie</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateSIMCard" method="post">
            <fieldset>
                <legend>Dane karty SIM</legend>

                <div class="form-group">
                    <label asp-for="PhoneNumber">Numer Telefonu</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="USIM"></label>
                    <input asp-for="USIM" class="form-control" />
                    <span asp-validation-for="USIM" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PIN"></label>
                    <input asp-for="PIN" class="form-control" />
                    <span asp-validation-for="PIN" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PUK"></label>
                    <input asp-for="PUK" class="form-control" />
                    <span asp-validation-for="PUK" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Op">Operator</label>
                    <input asp-for="Op" class="form-control" />
                    <span asp-validation-for="Op" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IP"></label>
                    <input asp-for="IP" class="form-control" />
                    <span asp-validation-for="IP" class="text-danger"></span>
                </div>
            </fieldset>
            <br />
            <br />
            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
