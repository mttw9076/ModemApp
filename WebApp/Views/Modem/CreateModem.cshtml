@using WebApp.Application.Devices.Commands.CreateModem
@model CreateModemCommand

@{
    ViewData["Title"] = "Dodaj Modem";
}

<h2>Dodaj urządzenie</h2>
<div class="row">
    <div class="col-md-4">

        <form asp-action="CreateModem" method="post">
            <fieldset>
                <legend>Dane modemu</legend>

                <div class="form-group">
                    <label asp-for="Model"></label>
                    <input asp-for="Model" class="form-control" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SerialNumber">Numer Seryjny</label>
                    <input asp-for="SerialNumber" class="form-control" />
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RU"></label>
                    <input asp-for="RU" class="form-control" />
                    <span asp-validation-for="RU" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PrevShopID">Poprzednia lokalizacja</label>
                    <input asp-for="PrevShopID" class="form-control" />
                    <span asp-validation-for="PrevShopID" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ShopID">Aktualna lokalizacja</label>
                    <input asp-for="ShopID" class="form-control" />
                    <span asp-validation-for="ShopID" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Place">Miejsce w drogerii</label>
                    <input asp-for="Place" class="form-control" />
                    <span asp-validation-for="Place" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description">Opis</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </fieldset>
             <button type="submit" class="btn btn-primary">Zapisz</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
